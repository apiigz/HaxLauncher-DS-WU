<Window x:Class="Launcher_Haxball_DS_WU.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HaxLauncher" Height="720" Width="1280"
        Background="#1A2125"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra superior: link de sala -->
        <Grid Grid.Row="0" Margin="6,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="LinkBox" Grid.Column="0" Height="26"
                     VerticalContentAlignment="Center"
                     ToolTip="Pegá acá el link de una sala (haxball.com/play?c=...) y apretá Enter. Atajo: Ctrl+L"
                     KeyDown="LinkBox_KeyDown" />
            <Button Grid.Column="1" Content="Entrar" Width="70" Margin="6,0,0,0"
                    Click="Go_Click" />
            <Button Grid.Column="2" Content="Pantalla completa" Padding="10,0" Margin="6,0,0,0"
                    Click="Fullscreen_Click" />
        </Grid>

        <!-- El WebView2 se crea en MainWindow.xaml.cs y se agrega en Grid.Row=1 -->
    </Grid>
</Window>
